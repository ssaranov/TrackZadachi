@page
@model TrackZadach.Pages.MissionsModel
@{
	ViewData["Title"] = "Missions";
}
<div class="container mt-5">
	<div class="d-flex justify-content-between align-items-center mb-4">
		<h1 class="mb-0">All projects</h1>
		<span class="badge bg-dark fs-6">
			Total projects: @Model.TotalProjectsCount
		</span>
	</div>

	@if (!string.IsNullOrEmpty(Model.Message))
	{
			<div class="alert alert-warning">
			@Model.Message
			</div>
	}
	<div class="card shadow mb-4">
		<div class="card-body">
			<h3 class="mb-3">Добавить задачу</h3>

			<form method="post" asp-page-handler="Add">
				<div calss="mb-3">
					<label class="form-label">Название задачи</label>
					<input asp-for="Name" class="form-control" />
				</div>

				<div calss="mb-3">
					<label class="form-label">Описание</label>
					<input asp-for="Description" class="form-control" rows="4" />
				</div>

				<div calss="mb-3">
					<label class="form-label">Статус</label>
					<input asp-for="Status" class="form-control" rows="4" />
					<select asp-for="Status" class="form-select">
						<option value="">
							Select Status
						</option>
						@foreach (var Status in Model.Status)
						{
								<option value="@Status">
								@Status
								</option>			
						}
					</select>
				</div>
				<button type="submit" class="btn btn-success">Добавить статус.</button>
				<button type ="reset" class="btn btn-cancel">Отмена</button>
			</form>
		</div>
	</div>
	<h3 class="mb-3">Список задач:</h3>ы
	@if (Model.Missions.Count == 0)
	{
			<div class="alert alert-info">
					Пока задачи нет.
			</div>

	}
	else
	{
			<div class="row">
			@foreach (var project in Model.Missions)
			{
					<div class="col-mb-6 mb-4">
						<div class="card mb-3 h-100 shadow-sm">
							<h4 class="mb-4 card-title"@project.NameTask>@project.NameTask</h4>
							<p class="mb-2">
								<span class="badge bg-primary">@project.Status</span>
							</p>
							<p class="card-text">@project.DescriptionTask</p>

							<div class="card-footer">
								<small class="d-block text-muted">
									Автор: @project.Author?.Name
								</small>
								<small class="d-block text-muted mb-2">
								Дата создания: @project.CreatedAt.ToString("dd.MM.yyyy HH:mm")
								</small>

								<a asp-page="/ProjectDetails" asp-route-id="@project.Id"
								class="btn btn-outline-primary btn-sm">
								Открыть
								</a>
							</div>
						</div>
					</div>
			}
			</div>
	}

</div>
