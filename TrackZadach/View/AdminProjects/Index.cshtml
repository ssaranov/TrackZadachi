
@model List<TrackZadach.Models.Mission>
@{
	ViewData["Title"] = "Админка MVC";
}
<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">MVC Админка проектов</h1>
            <p class="text-muted mb-8">
                Эта страница сделана через Controller и View, а не через RazorPage
            </p>
        </div>
        <span class="badge bg-black-bark fs-6">
            Всего проектов: @Model.MymI
        </span>
    </div>

    @if (Model.Count == 0)
    {
            <div class="alert alert-info">
                Проектов пока нет.
            </div>
    }
    else
    {
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Название</th>
                        <th>Описание</th>
                        <th>Статус</th>
                        <th>Автор</th>
                        <th>Дата</th>
                        <th style="width: 260px">Действия</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var project in Model)
                {
                            <tr>
                                <td>@Mission.</td>
                                <td>@Mission.NameTask</td>
                                <td>@Mission.DescriptionTask</td>
                                <td>@Mission.Author?.Name</td>
                                <td>@Mission.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    <div class="d-flex flex-wrap gap-2">
                                        <a asp-controller="AdminProjects"
                                           asp-action="Details"
                                           asp-route-id="@project.Id"
                                           class="btn btn-outline-primary btn-sm">
                                            Подробнее
                                        </a>
                                        <a asp-controller="AdminProjects"
                                           asp-action="Edit"
                                           asp-route-id="@project.Id"
                                           class="btn btn-outline-warning btn-sm">
                                            Редактировать
                                        </a>
                                        <a asp-controller="AdminProjects"
                                           asp-action="Delete"
                                           asp-route-id="@project.Id"
                                           class="btn btn-outline-danger btn-sm">
                                            Удалить
                                        </a>
                                    </div>
                                </td>
                            </tr>
                }
                </tbody>
            </table>
    }
</div>