@model TrackZadach.Models.Mission
@{
    ViewData["Title"] = "Редакт задачи";
    var statuses = new List<string> { "New", "Current", "Completed" };
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h1>Редактирование проекта</h1>

           
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-warning">
                    Пожалуйста, проверьте правильность заполнения полей.
                </div>
            }

            <form asp-controller="AdminMissions" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()

             
                <input asp-for="Id" type="hidden" />
                <input asp-for="AuthorId" type="hidden" />
                <input asp-for="CreatedAt" type="hidden" />

                <div class="mb-3">
                    <label class="form-label">Название проекта</label>
                    <input asp-for="NameTask" class="form-control" />
                    <span asp-validation-for="NameTask" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Описание</label>
                    <input asp-for="DescriptionTask" class="form-control" />
                    <span asp-validation-for="DescriptionTask" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Статус</label>
                    <select asp-for="Status" class="form-control" required>
                       
                        <option value="" disabled>-- Выберите статус --</option>
                        <option value="New">New</option>
                        <option value="Current">Current</option>
                        <option value="Completed">Completed</option>
                    </select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>



                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        Сохранить
                    </button>

                    <a asp-action="Index" class="btn btn-secondary">
                        Отмена
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
